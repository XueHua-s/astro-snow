---
import CategoryPostList from '@components/category/CategoryPostList.astro';
import HomeSider from '@components/layout/HomeSider.astro';
import Cover from '@components/ui/cover/Cover.astro';
import TwoColumnLayout from '@components/layout/TwoColumnLayout.astro';
import LayoutFooter from '@components/layout/LayoutFooter';
import { blogLayoutConfig } from '@/config/blogLayoutConfig';
import Layout from '@layouts/Layout.astro';
import { getCategoryByLink, getCategoryLinks, getCategoryList } from '@lib/content';
import { getLayoutFooterData } from '@lib/layout/footer-data';

// 获取分类页面
export async function getStaticPaths() {
  const { categories } = await getCategoryList();
  const links = getCategoryLinks(categories, '');
  return links.map((link) => {
    const category = getCategoryByLink(categories, link);
    return {
      params: { slug: decodeURIComponent(link) },
      props: { category },
    };
  });
}

const { category } = Astro.props;
const [{ categories: allCategories, countMap }, layoutFooterData] = await Promise.all([
  getCategoryList(),
  getLayoutFooterData(),
]);

// 如果是子分类，只展示当前分类的内容
const displayCategories = category ? [category] : allCategories;
const categoryName = category?.path.join(' / ') ?? '全部分类';
---

<Layout title={`${categoryName}文章分类 | ${blogLayoutConfig.title}`} description={`浏览雪花の博客「${categoryName}」分类下的文章。`}>
  <TwoColumnLayout>
    <Cover slot="cover" title={`分类于"${category?.name}"的文章`} />
    <HomeSider slot="sider" />
    <LayoutFooter slot="footer" {...layoutFooterData} />
    <CategoryPostList rootCategory={category} categories={displayCategories} countMap={countMap} />
  </TwoColumnLayout>
</Layout>
