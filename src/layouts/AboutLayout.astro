---
import HomeSider from '@components/layout/HomeSider.astro';
import Cover from '@components/ui/cover/Cover.astro';
import TwoColumnLayout from '@components/layout/TwoColumnLayout.astro';
import LayoutFooter from '@components/layout/LayoutFooter';
import { CONTENT_PADDING } from '@constants/layout';
import { blogSeoConfig } from '@/config/blogLayoutConfig';
import Layout from './Layout.astro';
import GiscusComments from '@/components/common/GiscusComments';
import { getLayoutFooterData } from '@lib/layout/footer-data';
import { defaultContentConfig } from '@constants/content-config';
import { CustomContentEnhancer } from '@components/common/CustomContentEnhancer';

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
const layoutFooterData = await getLayoutFooterData();
---

<Layout title={`${frontmatter.title} | ${blogSeoConfig.title}`}>
  <TwoColumnLayout>
    <Cover slot="cover" title="关于我" />
    <HomeSider slot="sider" />
    <LayoutFooter slot="footer" {...layoutFooterData} />
    <div
      class={`glass glass-panel mx-0 flex w-full flex-col gap-8 ${CONTENT_PADDING.standard}`}
      data-glass-panel>
      <div
        class="about-content prose md:prose-sm dark:prose-invert custom-content">
        <slot />
      </div>
      <CustomContentEnhancer client:idle config={defaultContentConfig} />
      <GiscusComments client:visible />
    </div>
  </TwoColumnLayout>
</Layout>

<style is="global">
  .about-content table {
    width: 100%;
    table-layout: fixed;
  }

  .about-content table td {
    width: 50%;
    padding: 0.5rem;
    vertical-align: top;
  }

  .about-content table .markdown-image-wrapper {
    margin: 0;
  }

  @media (max-width: 640px) {
    .about-content table,
    .about-content table tbody,
    .about-content table tr,
    .about-content table td {
      display: block;
      width: 100%;
    }

    .about-content table td {
      padding: 0.5rem 0;
    }
  }
</style>
