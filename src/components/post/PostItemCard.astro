---
// 导入所需的库和类型
import { Badge } from '@components/ui/badge';
import { Button } from '@components/ui/button';
import { Routes } from '@constants/router';
import { defaultCoverList } from '@/config/blogLayoutConfig';
import { buildCategoryPath, getCategoryArr, getPostDescriptionWithSummary } from '@lib/content';
import { parseDate } from '@lib/datetime';
import { getLqipProps } from '@lib/lqip';
import { routeBuilder } from '@lib/route';
import { cn } from '@lib/utils';
import readingTime from 'reading-time';
import type { BlogPost } from '@/types/blog';

export interface PostItemCardProps {
  data: BlogPost;
  leftClip?: boolean;
  randomCover: string;
  showTags?: boolean;
  hideCover?: boolean; // 隐藏图片，让内容铺满
  isSimple?: boolean; // 是否简单模式
  href?: string;
}

const {
  randomCover,
  data,
  leftClip = true,
  hideCover: hideCoverProp,
  showTags: showTagsProp,
  isSimple = false,
  href: hrefProp,
} = Astro.props as PostItemCardProps;

const showTags = showTagsProp ?? !isSimple;
const hideCover = hideCoverProp ?? isSimple;

const { cover, date, catalog, categories, title, draft } = data?.data ?? {};
const rawTags = data?.data?.tags;
const tags = Array.isArray(rawTags) ? rawTags : rawTags ? [rawTags] : [];
const { body } = data ?? {};

const readState = readingTime(body ?? '');
const finalCover = cover ?? randomCover ?? defaultCoverList[0];
const href = hrefProp ?? routeBuilder(Routes.Post, data as BlogPost);
const isDraft = import.meta.env.DEV && draft === true;

const categoryArr = getCategoryArr(categories);
const categoryLink = buildCategoryPath(categoryArr);
const categoryStr = categoryArr?.length ? categoryArr[categoryArr.length - 1] : '';

// 使用统一的工具函数获取文章描述（带 AI 摘要 fallback）
const postDescription = getPostDescriptionWithSummary(data);

// 获取 LQIP 样式用于图片占位符
const lqipProps = getLqipProps(finalCover);
---

<div
  class="glass glass-card glass-interactive group text-card-foreground relative flex gap-2 md:flex-col"
>
  {
    !hideCover && (
      <a
        aria-label="post-link"
        href={href}
        style={lqipProps.style}
        class={cn(
          'md:clip-path-none relative min-h-46.5 w-[calc(50%-2rem)] self-stretch overflow-hidden rounded-[calc(var(--glass-radius-card)-4px)] md:h-46.5 md:max-h-46.5 md:min-h-0 md:w-auto',
          leftClip ? 'clip-path-post-img-left order-1' : 'clip-path-post-img-right order-2',
          'md:clip-path-none md:order-none',
          lqipProps.class,
        )}
      >
        <img
          src={finalCover}
          loading="lazy"
          alt="post cover"
          class="absolute inset-0 h-full w-full cursor-pointer object-cover transition duration-500 group-hover:scale-[1.025]"
        />
      </a>
    )
  }
  <div
    class={cn(
      'flex min-w-0 flex-col gap-2 px-4 pt-4 md:pt-1',
      hideCover ? 'w-full' : 'w-[calc(50%+2rem)] md:w-full',
      !hideCover && (leftClip ? 'order-2' : 'order-1'),
      'md:order-none',
    )}
  >
    <div class={cn('flex w-full flex-wrap justify-between gap-2', { 'order-2 justify-start gap-4': isSimple })}>
      {
        catalog === false ? null : (
          <a href={categoryLink} class="flex-center hover:text-blue text-muted-foreground text-xs transition duration-300">
            <i class="fa-solid fa-flag text-xs" aria-hidden="true"></i>
            {categoryStr}
          </a>
        )
      }
      <div class="text-muted-foreground flex flex-wrap justify-end gap-x-4 gap-y-1 text-xs">
        {
          date ? (
            <p class="flex-center gap-1">
              <i class="fa-regular fa-calendar-days text-xs" aria-hidden="true"></i>
              {parseDate(date, 'YYYY-MM-DD')}
            </p>
          ) : null
        }
        <p class="flex-center gap-1">
          <i class="fa-solid fa-pen-nib text-xs" aria-hidden="true"></i>
          {readState?.words} 字
        </p>
        <button
          class="flex-center gap-1 md:hidden"
          title={`预计阅读时长: ${readState?.minutes} min`}
          data-tooltip-placement="top"
        >
          <i class="fa-regular fa-clock text-xs" aria-hidden="true"></i>
          {readState?.text}
        </button>
      </div>
    </div>
    <div class="mt-1 flex flex-col space-y-1.5 p-0">
      <div class="flex items-center gap-2">
        <a href={href} aria-label="post-link" class="min-w-0 flex-1"
          ><h1 class="text-primary hover:text-blue line-clamp-1 truncate text-xl font-bold transition-colors duration-300">
            {title}
          </h1>
        </a>
        {
          isDraft && (
            <Badge className="bg-yellow-700 border border-yellow-600/20 gap-1 text-white shrink-0 hover:bg-yellow-500 whitespace-nowrap transition-colors duration-300 ">
              <i class="fa-solid fa-file-pen text-xs" aria-hidden="true"></i>
              草稿
            </Badge>
          )
        }
      </div>
    </div>
    <p
      class={cn('text-muted-foreground line-clamp-3 h-15 text-sm md:h-auto md:max-h-15', {
        'line-clamp-2 h-10 md:max-h-10': isSimple,
      })}
    >
      {postDescription}
    </p>
    {/* FIXED: Tags and the corner action share normal flow, so neither can cover the other. */}
    <div class="order-3 -mx-4 -mb-px mt-auto flex min-w-0 items-end gap-3" data-post-footer>
      <div
        class={cn(
          'flex min-w-0 flex-1 flex-wrap gap-x-2 gap-y-1 pb-2',
          hideCover || leftClip ? 'pl-4' : 'justify-end pr-4 md:justify-start md:pr-0 md:pl-4',
        )}
        data-post-tags
      >
        {
          showTags && tags.map((tag: string) => (
            <Badge
              className="hover:text-badge-primary/80 min-w-0 max-w-full cursor-pointer gap-0.5 border-none px-1 text-xs font-bold transition-colors duration-300"
              variant="outline"
            >
              <i class="fa-solid fa-tags shrink-0 text-xs" aria-hidden="true"></i>
              <span class="min-w-0 truncate">{tag}</span>
            </Badge>
          ))
        }
      </div>
      <a
        href={href}
        aria-label="more info"
        class={cn(
          'shrink-0',
          hideCover || leftClip ? '-mr-px' : 'order-first -ml-px md:order-last md:ml-0 md:-mr-px',
        )}
      >
        <Button
          variant="ghost"
          className={cn(
            'material-action md:h-7 md:px-2 md:py-1 md:text-xs',
            hideCover || leftClip
              ? 'rounded-ss-2xl rounded-se-none rounded-ee-[var(--glass-radius-card)] rounded-es-none'
              : 'rounded-ss-none rounded-se-2xl rounded-ee-none rounded-es-[var(--glass-radius-card)] md:rounded-ss-2xl md:rounded-se-none md:rounded-ee-[var(--glass-radius-card)] md:rounded-es-none',
          )}
        >
          more...
        </Button>
      </a>
    </div>
  </div>
</div>
