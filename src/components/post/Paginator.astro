---
import { Button, buttonVariants } from '@components/ui/button';
import type { Page } from 'astro';
import { FaChevronLeft, FaChevronRight } from 'react-icons/fa';
import type { BlogPost } from '@/types/blog';
import { Routes } from '@constants/router';

interface Props {
  page: Page<BlogPost>;
  baseUrl?: string; // 分页基础路径，默认为 '/blog/posts'
  isHomePage?: boolean; // 是否是首页
}

const { page, baseUrl = Routes.Posts, isHomePage = false } = Astro.props;
const linkClass = buttonVariants({ variant: 'ghost' });

// 生成页面链接的辅助函数
const getPageUrl = (pageNum: number) => {
  // 如果是首页模式，第1页指向 '/blog'，其他页指向 '/blog/posts/x'
  if (isHomePage) {
    return pageNum === 1 ? Routes.Home : `${baseUrl}/${pageNum}`;
  }
  // 普通模式：第1页是 baseUrl，其他页是 baseUrl/2 等
  return pageNum === 1 ? baseUrl : `${baseUrl}/${pageNum}`;
};
---

<div class="flex-center gap-1 font-bold">
  {
    page.url.prev ? (
      <a href={page.url.prev} class={linkClass} aria-label="上一页">
        <FaChevronLeft aria-hidden="true" />
      </a>
    ) : (
      <Button variant="ghost" disabled aria-label="上一页">
        <FaChevronLeft />
      </Button>
    )
  }

  {
    page.currentPage !== 1 && page.currentPage - 1 !== 1 && (
      <a href={getPageUrl(1)} class={linkClass} aria-label="第 1 页">
        1
      </a>
    )
  }
  {page.currentPage > 2 && <span class="mx-1">...</span>}
  {
    page.currentPage !== 1 && (
      <a
        href={getPageUrl(page.currentPage - 1)}
        class={linkClass}
        aria-label={`第 ${page.currentPage - 1} 页`}>
        {page.currentPage - 1}
      </a>
    )
  }

  <Button
    variant="ghost"
    disabled
    aria-current="page"
    aria-label={`第 ${page.currentPage} 页，当前页`}
    className="text-primary disabled:opacity-100">
    {page.currentPage}
  </Button>

  {
    page.currentPage !== page.lastPage && (
      <a
        href={getPageUrl(page.currentPage + 1)}
        class={linkClass}
        aria-label={`第 ${page.currentPage + 1} 页`}>
        {page.currentPage + 1}
      </a>
    )
  }
  {page.currentPage < page.lastPage - 2 && <span class="mx-1">...</span>}
  {
    page.currentPage !== page.lastPage &&
      page.currentPage + 1 !== page.lastPage && (
        <a
          href={getPageUrl(page.lastPage)}
          class={linkClass}
          aria-label={`第 ${page.lastPage} 页`}>
          {page.lastPage}
        </a>
      )
  }
  {
    page.url.next ? (
      <a href={page.url.next} class={linkClass} aria-label="下一页">
        <FaChevronRight aria-hidden="true" />
      </a>
    ) : (
      <Button variant="ghost" disabled aria-label="下一页">
        <FaChevronRight />
      </Button>
    )
  }
</div>
