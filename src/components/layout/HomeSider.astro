---
import { HomeSiderType, HomeSiderSegmentType } from '@constants/enum';
import { cn } from '@lib/utils';
import { blogLayoutConfig } from '@/config/blogLayoutConfig';
import {
  getAllTags,
  getCategoryList,
  getCategoryNodeCount,
  getSortedPosts,
} from '@lib/content';
import { getPostSeriesViewModel } from '@lib/content/posts';
import { getLqipGradient } from '@lib/lqip';
import { routers } from '@constants/router';
import HomeSiderPanel from './HomeSiderPanel';
import type { BlogPost } from '@/types/blog';
import type { MarkdownHeading } from '@/types/markdown';

interface Props {
  type?: HomeSiderType;
  className?: string;
  isDrawer?: boolean;
  post?: BlogPost;
  tocHeadings?: MarkdownHeading[];
}

const {
  type = HomeSiderType.HOME,
  className,
  isDrawer = false,
  post,
  tocHeadings,
} = Astro.props;
const defaultSegmentType =
  type === HomeSiderType.POST
    ? HomeSiderSegmentType.DIRECTORY
    : HomeSiderSegmentType.INFO;
// FIXED: Avoid reusing the hydrated post sidebar across post-to-post client transitions.
const transitionName =
  !isDrawer && type !== HomeSiderType.POST ? 'page-home-sider' : undefined;

const [{ categories }, posts, postSeriesData] = await Promise.all([
  getCategoryList(),
  getSortedPosts(),
  post && type === HomeSiderType.POST ? getPostSeriesViewModel(post) : null,
]);

const avatar = blogLayoutConfig.avatar ?? '/img/avatar.webp';
const homeInfo = {
  avatar,
  avatarGradient: getLqipGradient(avatar),
  idPrefix: isDrawer ? 'drawer-sidebar' : 'desktop-sidebar',
  name: blogLayoutConfig?.name,
  description: blogLayoutConfig?.description,
  postCount: posts.length,
  categoryCount: getCategoryNodeCount(categories),
  tagCount: Object.keys(getAllTags(posts)).length,
  routes: routers,
  currentPath: Astro.url.pathname,
};

const seriesPostItems = postSeriesData?.seriesPostItems ?? [];
const prevPostItem = postSeriesData?.prevPostItem ?? null;
const nextPostItem = postSeriesData?.nextPostItem ?? null;
const currentPostSlug = postSeriesData?.currentPostSlug ?? undefined;
---

<div
  class={cn(
    'page-home-sider flex min-h-0 min-w-64 max-w-64 flex-col items-center overflow-hidden px-2 tablet:hidden',
    isDrawer
      ? 'flex-1'
      : 'glass glass-sidebar desktop-sidebar sticky self-start',
    className,
  )}
  {...transitionName ? { 'transition:name': transitionName } : {}}>
  <HomeSiderPanel
    client:media={isDrawer ? '(max-width: 992px)' : '(min-width: 993px)'}
    type={type}
    defaultSegmentType={defaultSegmentType}
    homeInfo={homeInfo}
    tocHeadings={tocHeadings}
    tocNumbering={post?.data.tocNumbering ?? true}
    seriesPostItems={seriesPostItems}
    currentPostSlug={currentPostSlug}
    prevPostItem={prevPostItem}
    nextPostItem={nextPostItem}
  />
</div>
