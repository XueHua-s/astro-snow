---
import FloatingGroupClient from './FloatingGroup';
---

<FloatingGroupClient client:idle />

<style is:global>
  #floating-nav {
    transition: transform 0.3s ease-in-out;
  }

  #nav-content {
    max-height: 10rem;
    overflow: hidden;
    transform-origin: bottom;
    transition:
      transform 0.15s ease-in-out,
      opacity 0.15s ease-in-out,
      max-height 0.15s ease-in-out;
  }

  #floating-nav[data-expanded='false'] #nav-content {
    max-height: 0;
    transform: translateY(150%);
    opacity: 0;
    pointer-events: none;
  }

  #floating-nav[data-expanded='false'] > .glass {
    gap: 0;
  }

  #floating-nav[data-expanded='true'] #nav-content {
    transform: translateY(0);
    opacity: 1;
  }

  #floating-nav button {
    opacity: 0.8;
    transition: opacity 0.2s ease-in-out;
  }

  #floating-nav button:hover {
    opacity: 1;
  }
</style>
