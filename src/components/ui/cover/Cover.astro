---
import { blogLayoutConfig } from '@/config/blogLayoutConfig';
import { parseDate } from '@lib/datetime';
import { getLqipStyle } from '@lib/lqip';
import { getBackgroundImages } from '@lib/backgrounds';
import readingTime from 'reading-time';
import type { BlogPost } from '@/types/blog';
import { MAX_WIDTH } from '@/constants/layout';
import CoverParticles from './CoverParticles.astro';

export interface CoverProps {
  data?: BlogPost;
  title?: string;
}

const { data, title } = Astro.props as CoverProps;

const { date, title: dataTitle, draft } = data?.data ?? {};

const readState = readingTime(data?.body ?? '');
const isDraft = import.meta.env.DEV && draft === true;

const backgroundImages = await getBackgroundImages();
const bannerSrc = backgroundImages.length
  ? backgroundImages[Math.floor(Math.random() * backgroundImages.length)]
  : blogLayoutConfig.banner.src;
const bannerLqipStyle = getLqipStyle(bannerSrc);
---

<div class="blog-cover relative isolate grid min-h-[clamp(21rem,54dvh,39rem)] place-items-center overflow-hidden">
  <div
    class="blog-cover-image absolute inset-0 -z-10"
    transition:persist="page-cover-banner"
    id="banner-box"
    style={bannerLqipStyle}
  >
    <img
      src={bannerSrc}
      alt={blogLayoutConfig.banner.alt ?? 'cover'}
      class="h-full w-full object-cover"
      sizes="100vw"
    />
  </div>
  <CoverParticles />
  <div class={`relative flex w-full flex-col items-center px-5 pb-20 pt-24 text-center text-white ${MAX_WIDTH.content}`}>
    {
      title ? (
        <h1
          class="blog-cover-title flex flex-wrap items-center justify-center gap-3 text-[clamp(1.75rem,4.5vw,3.25rem)] font-bold leading-tight"
        >
          {title}
          <button
            type="button"
            title="复制链接"
            class="inline-flex size-10 items-center justify-center rounded-full border border-white/30 bg-black/45 text-base hover:bg-black/65 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
            onclick="navigator.clipboard.writeText(window.location.href)"
            aria-label="复制链接"
          >
            <i class="fa-solid fa-link" aria-hidden="true"></i>
          </button>
        </h1>
      ) : data ? (
        <>
          <h1
            class="blog-cover-title flex flex-wrap items-center justify-center gap-3 text-[clamp(1.625rem,3.8vw,2.75rem)] font-bold leading-tight"
          >
            {dataTitle ?? title}
            {isDraft && (
              <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-3 py-1 text-sm font-semibold text-amber-950">
                <i class="fa-solid fa-file-pen text-sm md:text-xs" aria-hidden="true"></i>
                草稿
              </span>
            )}
          </h1>
          {data && (
            <p class="mt-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm md:text-xs">
              <span class="flex items-center gap-1">
                <i class="fa-regular fa-calendar-days" aria-hidden="true"></i>
                发表于 {parseDate(date ?? '', 'YYYY-MM-DD')}
              </span>
              <span class="flex items-center gap-1">
                <i class="fa-solid fa-pen-nib" aria-hidden="true"></i> {readState?.words} 字
              </span>
              <span class="flex items-center gap-1">
                <i class="fa-regular fa-clock" aria-hidden="true"></i>
                {readState?.text}
              </span>
            </p>
          )}
        </>
      ) : (
        <>
          <p class="font-chill-round text-xl">{blogLayoutConfig?.alternate}</p>
          <h1 class="blog-cover-title font-chill-round mt-2 text-[clamp(2.25rem,5vw,4rem)] font-bold leading-tight">
            {blogLayoutConfig?.title}
          </h1>
          <p class="mt-4 text-sm">{blogLayoutConfig?.subtitle}</p>
        </>
      )
    }
  </div>
</div>

<style>
  .blog-cover {
    background: var(--site-canvas);
  }

  .blog-cover::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--site-canvas), transparent 14%),
      linear-gradient(
        180deg,
        hsl(224 32% 9% / 0.72),
        hsl(224 32% 9% / 0.49) 59%,
        transparent 96%
      );
    content: '';
  }

  .blog-cover-title {
    overflow-wrap: anywhere;
    text-wrap: balance;
    text-shadow: 0 2px 8px hsl(224 32% 9% / 0.45);
  }

  @media (forced-colors: active) {
    .blog-cover-image,
    .blog-cover::before {
      visibility: hidden;
    }
  }
</style>
