---
import type { IconType } from 'react-icons';
import {
  FaBilibili,
  FaGithub,
  FaPenNib,
  FaTelegram,
  FaXTwitter,
} from 'react-icons/fa6';
import ResponsiveImage from '@components/common/ResponsiveImage.astro';
import { cn } from '@/lib/utils';
import {
  homePageLinks,
  homePageMusic,
  homePageProfile,
} from '../../config/homePageConfig';

interface SocialButton {
  href: string;
  icon: IconType;
  iconClass: string;
  label: string;
  external?: boolean;
}

function getSocialButtons(links: typeof homePageLinks): SocialButton[] {
  return [
    {
      href: links.bilibiliUrl,
      icon: FaBilibili,
      iconClass: 'fa-brands fa-bilibili',
      label: '哔哩哔哩',
      external: true,
    },
    {
      href: links.telegramUrl,
      icon: FaTelegram,
      iconClass: 'fa-brands fa-telegram',
      label: 'Telegram',
      external: true,
    },
    {
      href: links.xUrl,
      icon: FaXTwitter,
      iconClass: 'fa-brands fa-x-twitter',
      label: 'X',
      external: true,
    },
    {
      href: links.githubUrl,
      icon: FaGithub,
      iconClass: 'fa-brands fa-github',
      label: 'GitHub',
      external: true,
    },
    {
      href: '/blog',
      icon: FaPenNib,
      iconClass: 'fa-solid fa-pen-nib',
      label: '进入博客',
    },
  ];
}

interface Props {
  profile?: typeof homePageProfile;
  links?: typeof homePageLinks;
}

const { profile = homePageProfile, links = homePageLinks } = Astro.props;
---

<section class="relative h-screen overflow-hidden bg-gradient-to-br">
  <div class="absolute inset-0">
    <ResponsiveImage
      src={profile.backgroundUrl}
      fallback={homePageProfile.backgroundUrl}
      alt=""
      widths={[480, 768, 1200, 1600, 1920]}
      sizes="(max-width: 768px) max(100vw, 48rem), 100vw"
      class="fixed inset-0 h-screen w-screen object-cover opacity-70"
      loading="eager"
      decoding="async"
      fetchpriority="low"
    />
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/10 via-transparent to-black/35">
    </div>
  </div>

  <div class="relative mx-auto flex h-full w-full max-w-[860px] flex-col px-5">
    <div class="flex flex-1 items-center justify-center">
      <glass-hero
        class="glass glass-hero glass-refract relative block w-full p-6"
        data-glass-hero>
        <div
          class="glass-specular pointer-events-none -z-10"
          aria-hidden="true">
        </div>
        <div class="flex justify-center">
          <div
            class="relative mb-6 h-[150px] w-[150px] rounded-full border-2 border-[var(--glass-border)]">
            <ResponsiveImage
              src={profile.avatarUrl}
              fallback={homePageProfile.avatarUrl}
              alt={profile.avatarAlt}
              class="h-full w-full rounded-full object-cover"
              widths={[150, 300, 450]}
              sizes="150px"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        </div>

        <div class="text-center">
          <h1 class="text-[2.5rem] font-bold tracking-[1px]">
            {profile.name}
          </h1>
          <p
            class="mx-auto mt-3 max-w-[560px] px-5 text-[1.1rem] italic text-[#666] dark:text-gray-300">
            {profile.tagline}
          </p>
        </div>

        <div class="mt-6 flex flex-wrap justify-center gap-3">
          {
            getSocialButtons(links).map(
              ({ href, icon: Icon, iconClass, label, external }) => (
                <a
                  class={cn(
                    'flex min-w-[200px] items-center justify-center gap-2 rounded-[25px] px-5 py-2.5 text-sm font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[hsl(var(--glass-primary-hsl))]',
                    external
                      ? 'material-action'
                      : 'bg-[hsl(var(--glass-primary-hsl))] text-[hsl(var(--glass-primary-ink))] hover:brightness-110',
                  )}
                  href={href}
                  {...(external
                    ? { target: '_blank', rel: 'noreferrer' }
                    : {})}>
                  <Icon
                    className={`${iconClass} w-auto text-base`}
                    aria-hidden="true"
                    focusable="false"
                  />
                  {label}
                </a>
              ),
            )
          }
        </div>
      </glass-hero>
    </div>

    <div class="fixed bottom-6 right-6 z-20 flex flex-col items-start gap-2">
      <div class="glass glass-flat h-[86px] w-[86px] overflow-hidden">
        <iframe
          title="网易云音乐播放器"
          width={homePageMusic.size}
          height={homePageMusic.size}
          src={homePageMusic.src}
          sandbox="allow-scripts allow-same-origin"
          style={{ border: 0 }}></iframe>
      </div>
    </div>

    <footer class="pb-6 text-center text-sm text-pink-main">
      {profile.footerText}
    </footer>
  </div>
</section>
<script>
  import { animateHero } from './hero-motion';

  class GlassHero extends HTMLElement {
    private dispose?: () => void;

    connectedCallback() {
      this.dispose = animateHero(this);
    }

    disconnectedCallback() {
      this.dispose?.();
      this.dispose = undefined;
    }
  }

  if (!customElements.get('glass-hero')) {
    customElements.define('glass-hero', GlassHero);
  }
</script>
