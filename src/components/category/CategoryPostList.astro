---
import { CONTENT_PADDING } from '@constants/layout';
import { Routes } from '@constants/router';
import {
  getPostHref,
  getPostIndexMap,
  getPostsByCategoryPath,
  type Category,
} from '@lib/content';
import SubCategory from './SubCategory.astro';
import { cn, hasItems } from '@lib/utils';
import { parseDate } from '@lib/datetime';

interface Props {
  categories: Category[];
  countMap: Record<string, number>;
  // category page
  rootCategory: Category | null;
}
const { categories, countMap, rootCategory } = Astro.props;
const posts = await getPostsByCategoryPath(rootCategory?.path ?? '');
const postIndexMap = await getPostIndexMap();
const hasPosts = hasItems(posts);
const hasRootChildren = hasItems(rootCategory?.children ?? []);
---

<div
  class={`shadow-box mx-0 flex w-full flex-col bg-gradient-start ${CONTENT_PADDING.normal}`}>
  <h2
    class={cn(
      'shoka-decoration-circle px-6 group relative py-5 text-2xl/9 font-bold',
      {
        'has-children': hasPosts || hasRootChildren,
      },
    )}>
    <a
      href={Routes.Home}
      class="dashed-border border-b text-muted-foreground hover:text-blue">
      首页
    </a>
    <span class="mx-2 text-xl text-muted-foreground">/</span>
    <span class="text-muted-foreground">{rootCategory?.name}</span>
    <span class="mx-2 text-xl text-muted-foreground">分类</span>
  </h2>

  <div class="flex w-full flex-col">
    {
      categories.map((category) => {
        const children = category.children ?? [];
        const hasChildren = hasItems(children);

        return hasChildren ? (
          <div class="category-first-level-container flex flex-col">
            {children.map((child) => (
              <SubCategory category={child} countMap={countMap} />
            ))}
          </div>
        ) : null;
      })
    }
    {
      hasPosts ? (
        <div class="category-second-level-container flex flex-col">
          {posts.map((post) => (
            <p class="shoka-decoration-circle group relative px-6 py-2 text-base/9 text-primary hover:text-blue">
              <span class="mr-2 text-xs text-muted-foreground">
                {parseDate(post?.data?.date, 'YY-MM-DD')}
              </span>
              <a href={getPostHref(post, postIndexMap)} class="dashed-border">
                {post?.data?.title}
              </a>
            </p>
          ))}
        </div>
      ) : null
    }
  </div>
</div>
